# Пример переменных окружения backend. Скопируйте в .env и заполните.
# Решения владельца (почта, события, реквизиты продавца, скидка за год, ЮKassa) —
# комплект с пояснениями и проверкой: docs/OWNER-SETUP.md. В Docker `.env` кладётся
# рядом с docker-compose.yml: compose передаёт контейнерам каждую переменную отсюда.

# Окружение: development | production. В production JWT_SECRET обязан быть задан
# и не равен заглушке — иначе приложение не стартует.
APP_ENV=development

# База данных (SQLAlchemy URL). Локально — SQLite; в проде — PostgreSQL.
# DATABASE_URL=sqlite:///./backend_dev.db
DATABASE_URL=postgresql+psycopg://finans_app:finans_app@localhost:5432/finans

# Пароли базы в docker-compose.yml: суперпользователь finans (обслуживание, резервные
# копии) и роль приложения finans_app — без прав суперпользователя, иначе изоляция
# организаций в базе (RLS) не действует. Роль заводит сервис db-setup при каждом старте.
# В пароле роли приложения без символов @ : / ? # % (он стоит в адресе подключения).
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too

# JWT
JWT_SECRET=change-me-in-production
JWT_TTL_SECONDS=86400

# CORS: список origin через запятую (для раздельного деплоя фронта и API).
# Пусто → один origin за nginx, CORS выключен.
CORS_ORIGINS=

# Ограничение частоты запросов к /auth (защита от перебора). true|false.
RATE_LIMIT_ENABLED=true

# Уровень логирования (DEBUG|INFO|WARNING|ERROR).
LOG_LEVEL=INFO

# Celery (фоновый анализ). Брокер и бэкенд результатов — Redis.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# В тестах — синхронное выполнение без брокера (CELERY_TASK_ALWAYS_EAGER=1).

# ЮKassa. Не заданы: вне продакшена — ручной провайдер (тариф сразу и без денег, для
# разработки), в продакшене — оплата в продукте отказывает с причиной и называет оплату
# по счёту (G1): забытая настройка не должна превращаться в бесплатный тариф.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1

# Месяцев в подарок за оплату года (G5). Решение владельца — два: год стоит ровно как
# 10 месяцев. Пусто или 0 — подарка нет. Значение вне 0–6 или не целое не применяется
# и называется на «Готовности» («12» вместо «2» отдало бы год даром). В счёте и акте
# подарка нет — там 12 месяцев одной суммой. Прежняя процентная настройка
# (ANNUAL_DISCOUNT_PERCENT) заменена этой и больше не читается.
ANNUAL_FREE_MONTHS=2

# Отчётность фирмы-цели по ИНН из ГИР БО («Финанс-Аудит», L3). Запрос уходит с сервера на
# ресурс ФНС; 0 — выключить (например, если установке запрещены внешние запросы), тогда
# отчётность вводится из Excel. Адрес ресурса — на случай его переезда (уже переезжал с
# bo.nalog.ru); пусто — https://bo.nalog.gov.ru.
GIRBO_ENABLED=1
GIRBO_BASE_URL=

# Реквизиты платформы как продавца — для счетов и актов (G6). Пока обязательные не
# заданы (или в них ошибка: ИНН, КПП, ключ счёта по БИК), документы не формируются и
# отказ это называет: бланк с пустыми реквизитами выглядел бы настоящим.
SELLER_NAME=
SELLER_INN=
# КПП — у юридического лица; у ИП оставьте пустым.
SELLER_KPP=
SELLER_ADDRESS=
SELLER_BANK=
SELLER_BIK=
SELLER_ACCOUNT=
SELLER_CORR_ACCOUNT=
# Кто подписывает документы (обязательно); главный бухгалтер — если есть.
SELLER_DIRECTOR=
SELLER_ACCOUNTANT=
# Ставка НДС, %: пусто — продавец без НДС («Без налога (НДС)»); число — НДС в цене.
SELLER_VAT_RATE=
# Для публичных страниц (L5): реквизиты на сайте и контакт для обращений, в том числе
# по персональным данным. Счетам и актам не обязательны; незаданное страница помечает.
SELLER_OGRN=
SELLER_EMAIL=
SELLER_PHONE=

# Редакция юридических документов (оферта, политика ПД, согласие) — дата, когда юрист
# их утвердил, например 2026-10-15. Пусто — над текстами стоит «Черновик», а
# «Готовность» называет это проблемой: тексты подготовлены платформой и не проверены.
LEGAL_DOCS_EDITION=

# Почта (D1). Пока MAIL_BACKEND=off, платформа писем не отправляет — и **не делает
# вид**, что отправляет: экран входа не показывает «Забыли пароль?», а приглашение
# честно говорит, что ссылку надо передать лично.
# off | smtp | memory (memory — тесты и разработка: письма складываются в память)
MAIL_BACKEND=off
# Адрес приложения для ссылок в письмах (без него ссылка уйдёт относительным путём).
PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=
# starttls (по умолчанию, порт 587) | ssl (465) | none
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT=10
MAIL_FROM=no-reply@finans-elite.ru
MAIL_FROM_NAME=Финанс-Элит

# События пользования продуктом (E2). Решение владельца — собирать (USAGE_EVENTS=1);
# в коде по умолчанию сбор выключен, включает его установка. Участник в событиях
# обезличен отпечатком с солью — задайте её отдельно от JWT_SECRET (случайная строка от
# 32 символов): без неё отпечатки зависят от ключа токенов, и его смена порвёт ряды
# удержания — «Готовность» называет это проблемой. Содержимого моделей клиента в
# событиях нет. Нужен пункт об аналитике в политике обработки ПД; срок хранения —
# политика эксплуатации.
USAGE_EVENTS=1
USAGE_SALT=

# Трекер ошибок (G7), Sentry-совместимый (подходит и GlitchTip у себя). Пусто — выключен
# и не отправляет ничего. До отправки вычищаются тело запроса, куки, строка запроса,
# заголовки кроме безопасных, сведения о пользователе, локальные переменные, а в тексте —
# почта, токены и ключи API (152-ФЗ). Ошибки интерфейса идут через свой маршрут API.
SENTRY_DSN=

# Оповещение о зависших задачах анализа (G8), минуты: задача в очереди или в счёте
# дольше порога — письмо операторам платформы, одно на задачу. Пусто или 0 — выключено:
# порог — решение эксплуатации. Не больше 59: состояние задачи хранится час, и дольше
# «зависла» не отличить от «посчитана давно». Нужна почта (письмо информационное — на
# неподтверждённый адрес оператора не уходит).
STUCK_JOB_ALERT_MINUTES=

# Резервные копии (L11) — сервис backup в docker-compose.yml: pg_dump раз в сутки в
# BACKUP_HOUR_UTC часов по UTC, хранение BACKUP_KEEP_DAYS дней, проверка восстановления
# раз в RESTORE_CHECK_DAYS дней. BACKUP_DIR — где API видит отметки службы («Готовность»).
# Копии лежат на этом же сервере — вынесите копию за его пределы (docs/HOSTING-CHECKLIST.md).
BACKUP_HOUR_UTC=1
BACKUP_KEEP_DAYS=14
RESTORE_CHECK_DAYS=7
BACKUP_DIR=/backups
