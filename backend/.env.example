# Пример переменных окружения backend. Скопируйте в .env и заполните.
# Решения владельца (почта, события, реквизиты продавца, скидка за год, ЮKassa) —
# комплект с пояснениями и проверкой: docs/OWNER-SETUP.md. В Docker `.env` кладётся
# рядом с docker-compose.yml: compose передаёт контейнерам каждую переменную отсюда.

# Окружение: development | production. В production JWT_SECRET обязан быть задан
# и не равен заглушке — иначе приложение не стартует.
APP_ENV=development

# База данных (SQLAlchemy URL). Локально — SQLite; в проде — PostgreSQL.
# DATABASE_URL=sqlite:///./backend_dev.db
DATABASE_URL=postgresql+psycopg://finans:finans@localhost:5432/finans

# JWT
JWT_SECRET=change-me-in-production
JWT_TTL_SECONDS=86400

# CORS: список origin через запятую (для раздельного деплоя фронта и API).
# Пусто → один origin за nginx, CORS выключен.
CORS_ORIGINS=

# Ограничение частоты запросов к /auth (защита от перебора). true|false.
RATE_LIMIT_ENABLED=true

# Уровень логирования (DEBUG|INFO|WARNING|ERROR).
LOG_LEVEL=INFO

# Celery (фоновый анализ). Брокер и бэкенд результатов — Redis.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# В тестах — синхронное выполнение без брокера (CELERY_TASK_ALWAYS_EAGER=1).

# ЮKassa. Не заданы: вне продакшена — ручной провайдер (тариф сразу и без денег, для
# разработки), в продакшене — оплата в продукте отказывает с причиной и называет оплату
# по счёту (G1): забытая настройка не должна превращаться в бесплатный тариф.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1

# Скидка за оплату года, % (G5). Пусто или 0 — скидки нет: размер скидки — решение
# владельца. Значение вне 0–50 или не число не применяется и называется.
ANNUAL_DISCOUNT_PERCENT=0

# Реквизиты платформы как продавца — для счетов и актов (G6). Пока обязательные не
# заданы (или в них ошибка: ИНН, КПП, ключ счёта по БИК), документы не формируются и
# отказ это называет: бланк с пустыми реквизитами выглядел бы настоящим.
SELLER_NAME=
SELLER_INN=
# КПП — у юридического лица; у ИП оставьте пустым.
SELLER_KPP=
SELLER_ADDRESS=
SELLER_BANK=
SELLER_BIK=
SELLER_ACCOUNT=
SELLER_CORR_ACCOUNT=
# Кто подписывает документы (обязательно); главный бухгалтер — если есть.
SELLER_DIRECTOR=
SELLER_ACCOUNTANT=
# Ставка НДС, %: пусто — продавец без НДС («Без налога (НДС)»); число — НДС в цене.
SELLER_VAT_RATE=

# Почта (D1). Пока MAIL_BACKEND=off, платформа писем не отправляет — и **не делает
# вид**, что отправляет: экран входа не показывает «Забыли пароль?», а приглашение
# честно говорит, что ссылку надо передать лично.
# off | smtp | memory (memory — тесты и разработка: письма складываются в память)
MAIL_BACKEND=off
# Адрес приложения для ссылок в письмах (без него ссылка уйдёт относительным путём).
PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=
# starttls (по умолчанию, порт 587) | ssl (465) | none
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT=10
MAIL_FROM=no-reply@finans-elite.ru
MAIL_FROM_NAME=Финанс-Элит

# События пользования продуктом (E2). Пока выключено, платформа не записывает ни одного
# события: аналитика пользования — решение владельца установки, а не умолчание.
# Участник в событиях обезличен отпечатком с этой солью (по умолчанию — JWT_SECRET);
# содержимого моделей клиента в событиях нет. Срок хранения — политика эксплуатации.
USAGE_EVENTS=0
USAGE_SALT=

# Трекер ошибок (G7), Sentry-совместимый (подходит и GlitchTip у себя). Пусто — выключен
# и не отправляет ничего. До отправки вычищаются тело запроса, куки, строка запроса,
# заголовки кроме безопасных, сведения о пользователе, локальные переменные, а в тексте —
# почта, токены и ключи API (152-ФЗ). Ошибки интерфейса идут через свой маршрут API.
SENTRY_DSN=

# Оповещение о зависших задачах анализа (G8), минуты: задача в очереди или в счёте
# дольше порога — письмо операторам платформы, одно на задачу. Пусто или 0 — выключено:
# порог — решение эксплуатации. Не больше 59: состояние задачи хранится час, и дольше
# «зависла» не отличить от «посчитана давно». Нужна почта (письмо информационное — на
# неподтверждённый адрес оператора не уходит).
STUCK_JOB_ALERT_MINUTES=
